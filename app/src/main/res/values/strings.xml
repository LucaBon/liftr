    <!-- Measurement Accuracy -->
    <string name="accuracy_info_title">Measurement Accuracy</string>
    <string name="accuracy_info_description">Lift Helper uses computer vision and biomechanics calculations to track your movements. Accuracy depends on several factors:</string>
    <string name="accuracy_centered">Best accuracy (98–99%): Keep your body centered in the frame</string>
    <string name="accuracy_edge">Reduced accuracy (90–95%): Measurements near frame edges affected by lens distortion</string>
    <string name="accuracy_optimal">Optimal conditions: Portrait or landscape mode, proper lighting, full body visible</string>
    <string name="accuracy_tip">Tip: The app automatically corrects for lens distortion on supported devices. For best results, follow the centering guide during calibration.</string>

